# TikTok Developer Console → Your App → Basic Info → App Secret
TIKTOK_CLIENT_SECRET=your_app_secret_here

# Optional: Custom verify token (if you set one in TikTok Console → Webhooks → Verify Token)
# TIKTOK_WEBHOOK_VERIFY_TOKEN=your_custom_verify_token

# Optional: Redis for BullMQ async queue (recommended for production)
# Get free Redis from: https://upstash.com (free tier: 10k requests/day)
# Format: rediss://user:password@host:port (TLS) or redis://host:port
# REDIS_URL=rediss://default:password@fly-upstash-redis.upstash.io:6379